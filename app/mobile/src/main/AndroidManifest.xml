<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- Without this, Android 11+ package visibility hides every text-to-speech engine from us
         and the lap calls fail silently rather than loudly. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:theme="@style/Theme.Widscan">

        <activity
            android:name=".Widscan58Activity"
            android:configChanges="screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Descriptor dump, for when the board shows up but is not a CDC port. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/probe_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The tutorial is a page in assets, opened only from inside the app. -->
        <activity
            android:name=".HelpActivity"
            android:configChanges="screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="false"
            android:label="@string/help_title"
            android:screenOrientation="portrait" />
    </application>
</manifest>
